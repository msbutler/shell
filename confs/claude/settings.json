{
  "model": "claude-opus-4-8",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true
  },
  "editorMode": "vim",
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(bazel:*)",
      "Bash(basename:*)",
      "Bash(cargo:*)",
      "Bash(cat:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(dev:*)",
      "Bash(./dev:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(printenv:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(roachdev:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(staticcheck:*)",
      "Bash(strings:*)",
      "Bash(tail:*)",
      "Bash(tar --extract:*)",
      "Bash(tar -x:*)",
      "Bash(tar x:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(type:*)",
      "Bash(uniq:*)",
      "Bash(unzip:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(xargs:*)",
      "WebFetch(domain:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:objects.githubusercontent.com)",
      "WebFetch(domain:codeload.github.com)",
      "WebFetch(domain:proxy.golang.org)",
      "WebFetch(domain:sum.golang.org)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:aiplatform.googleapis.com)",
      "WebFetch(domain:us-aiplatform.googleapis.com)",
      "WebFetch(domain:json.schemastore.org)",
      "WebFetch(domain:cdn.jsdelivr.net)",
      "WebFetch(domain:unpkg.com)",
      "WebFetch(domain:registry.yarnpkg.com)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "network": {
      "allowedDomains": ["*"]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/private/tmp",
        "/var/folders",
        "/private/var/folders",
        "~/.roachdev",
        "~/go",
        "~/.cache/go-build",
        "~/Library/Caches/go-build",
        "~/.config/go",
        "~/.cache/gopls",
        "~/Library/Caches/gopls",
        "~/.npm",
        "~/.npmrc",
        "~/.config/npm",
        "~/.cache/npm",
        "~/Library/Caches/npm",
        "~/.nvm",
        "~/.local/bin/uv",
        "~/.local/bin/uvx",
        "~/.local/share/uv",
        "~/.local/state/uv",
        "~/.cache/uv",
        "~/Library/Caches/uv",
        "~/.config/uv",
        "~/.config/gh",
        "~/.cache/gh",
        "~/.local/share/gh",
        "~/.local/state/gh",
        "~/.claude",
        "~/.cache/claude",
        "~/.config/claude",
        "~/.local/state/claude",
        "~/.local/share/claude",
        "~/.claude.json",
        "~/.shell/confs/claude/settings.json",
        "~/Library/Application Support/engflow_auth"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.azure",
        "~/.azd",
        "~/.gnupg",
        "~/.kube"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.azure",
        "~/.azd",
        "~/.gnupg",
        "~/.kube"
      ],
      "allowRead": [
        "~/.ssh/config",
        "~/.ssh/known_hosts"
      ]
    }
  }
}
